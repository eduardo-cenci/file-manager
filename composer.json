{
  "name": "eduardo-cenci/file-manager",
  "type": "project",
  "autoload": {
    "psr-4": {
      "EduardoCenci\\FileManager\\": "src/"
    }
  },
  "require": {
    "php": "^8.5",
    "robmorgan/phinx": "^0.16.12",
    "nikic/fast-route": "^1.3",
    "respect/validation": "^3.1",
    "php-di/php-di": "^7.1",
    "league/plates": "^3.6"
  },
  "scripts": {
    "migrate": "vendor/bin/phinx migrate -c config/phinx.php",
    "seed": "vendor/bin/phinx seed:run -c config/phinx.php"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
